--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -176,6 +176,32 @@
 #include <i386/pmCPU.h>
 static void             kernel_bootstrap_thread(void);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* STAR: screen colour = code position. The console is disabled first, because
+ * fbcon scrolls by repainting cell backgrounds black and would wipe the colour. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+#define STAR_FB_BASE   0xea600000UL
+#define STAR_FB_BYTES  0x119c000UL
+static void
+star_paint(uint32_t color)
+{
+	PE_Video video;
+	volatile uint32_t *fb;
+
+	PE_current_console(&video);
+	PE_initialize_console(&video, kPEDisableScreen);
+	fb = (volatile uint32_t *)ml_io_map(STAR_FB_BASE, STAR_FB_BYTES);
+	if (fb == NULL) {
+		return;
+	}
+	for (unsigned i = 0; i < STAR_FB_BYTES / 4; i++) {
+		fb[i] = color;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
+
 static void             load_context(
 	thread_t        thread);
 
@@ -770,18 +796,30 @@
 
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_lockdown_iokit");
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	star_paint(0xff808080);		/* GRAY: entering PE_lockdown_iokit */
+#endif
 	PE_lockdown_iokit();
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	star_paint(0xffffff00);		/* YELLOW: PE_lockdown_iokit returned */
+#endif
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
 	 * at the latest
 	 */
 	vm_set_restrictions(machine_info.max_cpus);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	star_paint(0xff00ffff);		/* CYAN: vm_set_restrictions done */
+#endif
 
 
 #if KPERF
 	kperf_init_early();
 #endif
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	star_paint(0xffff00ff);		/* MAGENTA: kperf_init_early done */
+#endif
 
 	/*
 	 *	Start the user bootstrap.
