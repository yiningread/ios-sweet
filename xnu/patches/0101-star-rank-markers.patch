+++ b/bsd/kern/bsd_init.c
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* ---- STAR bring-up instrumentation ---------------------------------- */
+#define STAR_MARK(rank_) \
+	__startup_func static void star_mark_##rank_(void) \
+	{ kprintf("STAR RANK %d\n", (int)(rank_)); } \
+	STARTUP(EARLY_BOOT, (startup_rank_t)(rank_), star_mark_##rank_);
+
+STAR_MARK(2)
+STAR_MARK(4)
+STAR_MARK(8)
+STAR_MARK(16)
+STAR_MARK(32)
+STAR_MARK(64)
+STAR_MARK(128)
+STAR_MARK(256)
+STAR_MARK(512)
+STAR_MARK(1024)
+STAR_MARK(2048)
+STAR_MARK(4096)
+STAR_MARK(8192)
+STAR_MARK(16384)
+STAR_MARK(32768)
+STAR_MARK(65536)
+STAR_MARK(131072)
+STAR_MARK(262144)
+STAR_MARK(524288)
+STAR_MARK(1048576)
+STAR_MARK(2097152)
+STAR_MARK(4194304)
+STAR_MARK(8388608)
+STAR_MARK(16777216)
+STAR_MARK(33554432)
+STAR_MARK(67108864)
+STAR_MARK(134217728)
+STAR_MARK(268435456)
+STAR_MARK(536870912)
+STAR_MARK(2147483646)
+
+/*
+ * The bootloader leaves Qualcomm's APCS watchdog (qcom,wdt@17c10000) running
+ * and nothing in this port pets it: the SoC resets ~20-30 s into boot.
+ * Disable it outright (research kernel, no watchdog wanted).
+ */
+#define STAR_WDT_BASE 0x17c10000UL
+#define STAR_WDT_RST  0x0004
+#define STAR_WDT_EN   0x0008
+#define STAR_WDT_STS  0x000c
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+__startup_func
+static void
+star_wdt_disable(void)
+{
+	volatile uint32_t *wdt = (volatile uint32_t *)ml_io_map(STAR_WDT_BASE, 0x1000);
+	if (wdt == NULL) {
+		kprintf("STAR WDT: map failed\n");
+		return;
+	}
+	wdt[STAR_WDT_EN / 4] = 0;
+	wdt[STAR_WDT_RST / 4] = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+	kprintf("STAR WDT: APCS watchdog disabled (status 0x%x)\n", wdt[STAR_WDT_STS / 4]);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_NTH(2), star_wdt_disable);
+#endif /* ARM64_BOARD_CONFIG_SWEET */
