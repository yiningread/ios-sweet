--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1566,3 +1566,31 @@
 	return 0;
 }
 #endif
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * STAR: the bootloader leaves Qualcomm's APCS watchdog (qcom,wdt@17c10000)
+ * running; nothing in this port pets it, so the SoC resets ~20-30 s into
+ * boot. Disable it outright (we are a research kernel; no watchdog wanted).
+ */
+#define STAR_WDT_BASE 0x17c10000UL
+#define STAR_WDT_RST  0x0004
+#define STAR_WDT_EN   0x0008
+
+__startup_func
+static void
+star_wdt_disable(void)
+{
+	volatile uint32_t *wdt = (volatile uint32_t *)ml_io_map(STAR_WDT_BASE, 0x1000);
+	if (wdt == NULL) {
+		kprintf("STAR WDT: map failed\n");
+		return;
+	}
+	wdt[STAR_WDT_EN / 4] = 0;              /* disable */
+	wdt[STAR_WDT_RST / 4] = 1;             /* kick once */
+	__asm__ volatile("dsb sy" ::: "memory");
+	kprintf("STAR WDT: APCS watchdog disabled (status 0x%x)\n",
+	    wdt[0x0c / 4]);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_NTH(2), star_wdt_disable);
+#endif /* ARM64_BOARD_CONFIG_SWEET */
