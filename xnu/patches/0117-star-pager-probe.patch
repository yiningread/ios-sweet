 		if (0 == (err = vfs_mountroot())) {
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 			kprintf("STAR BSD: vfs_mountroot OK, root=%s\n", rootdevice);
+			{
+				extern void star_pager_probe(void);
+				star_pager_probe();
