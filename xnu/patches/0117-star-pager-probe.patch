 #endif
 			break;
 		}
@@ -1104,6 +1108,45 @@
 	lock_trace = 1;
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * STAR: read 4 KiB from deep inside one shared-cache subfile straight through the
+ * vnode pager. Compared with the same bytes on the host this says whether dyld
+ * gets the cache contents the file really holds.
+ */
+void
+star_pager_probe(void)
+{
+	static char probe_buf[4096];
+	const char *path = "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.01";
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	uint64_t fnv = 0xcbf29ce484222325ULL;
+	int error;
+
+	error = vnode_lookup(path, 0, &vp, ctx);
+	if (error != 0) {
+		kprintf("STAR PAGER: lookup failed %d\n", error);
+		return;
+	}
+	error = vn_rdwr(UIO_READ, vp, probe_buf, sizeof(probe_buf), (off_t)0x6400000LL,
+	    UIO_SYSSPACE, 0, kauth_cred_get(), NULL, current_proc());
+	if (error == 0) {
+		for (size_t i = 0; i < sizeof(probe_buf); i++) {
+			fnv ^= (uint8_t)probe_buf[i];
+			fnv *= 0x100000001b3ULL;
+		}
+		kprintf("STAR PAGER: 4K@0x6400000 fnv=0x%llx head=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+		    fnv, (uint8_t)probe_buf[0], (uint8_t)probe_buf[1], (uint8_t)probe_buf[2],
+		    (uint8_t)probe_buf[3], (uint8_t)probe_buf[4], (uint8_t)probe_buf[5],
+		    (uint8_t)probe_buf[6], (uint8_t)probe_buf[7]);
+	} else {
+		kprintf("STAR PAGER: vn_rdwr failed %d\n", error);
+	}
+	vnode_put(vp);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 kern_return_t
 bsd_autoconf(void)
 {
